<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Griip" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/canvas_light</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <!-- Launch screen (AndroidX SplashScreen: the Android 12+ system splash, and the same look on 8–11). The Orbit symbol
         on near-black green, shown only until the first frame; then the app theme above. -->
    <style name="Theme.Orbit.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/orbit_night</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/orbit_mark</item>
        <item name="postSplashScreenTheme">@style/Theme.Griip</item>
    </style>
</resources>
