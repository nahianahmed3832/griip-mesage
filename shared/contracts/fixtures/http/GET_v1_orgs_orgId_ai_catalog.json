{
  "agents": [
    {
      "agent": {
        "id": "product_video_editor",
        "version": 1,
        "name": "Product Video Editor",
        "description": "Cuts your footage into a product video: chooses scenes, transcribes speech for captions, adds a title and brand text, renders a preview for approval and exports the final file.",
        "roleTitle": "AI video editor",
        "category": "media",
        "capabilities": [
          "Reads real footage durations and streams",
          "Captions from speech-to-text, when configured",
          "Scene selection checked against the footage",
          "Preview, approval, then final MP4 export with the server's media engine",
          "Revisions on request"
        ],
        "examples": [
          "A 30-second video from these clips for our launch: energetic, with captions."
        ],
        "avatarColor": "#F76B15",
        "skill": {
          "id": "video.edit",
          "version": 1,
          "tools": [
            "files.read",
            "files.write",
            "channel.post",
            "media.probe",
            "media.extract_audio",
            "media.render",
            "social.publish"
          ],
          "requiredTools": [
            "files.write",
            "media.probe",
            "media.render"
          ],
          "modelCategories": [
            "reasoning",
            "transcription"
          ],
          "requiredModelCategories": [
            "reasoning"
          ],
          "files": {
            "min": 1,
            "max": 10,
            "maxBytes": 524288000,
            "types": [
              "video/mp4",
              "video/quicktime",
              "video/webm"
            ]
          },
          "readsMessages": false,
          "limits": {
            "maxRuntimeSec": 1800,
            "maxModelCalls": 16,
            "maxAttempts": 2,
            "maxOutputFiles": 40
          },
          "approvals": [
            "In review mode the final export waits for approval of the exact preview (bound to its SHA-256); a revision makes a new preview and voids the old approval.",
            "Publishing outside Meldiq (social.publish) always needs its own approval and a connection that doesn't exist yet."
          ],
          "errors": [
            "No video file: refused before the job starts.",
            "No media engine on the server: the job fails with media_engine_unavailable.",
            "No speech-to-text model: the video is made without captions and says so.",
            "A scene plan outside the footage: replaced by evenly spaced pieces, and the job says so."
          ],
          "inputSchema": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "type": "object",
            "properties": {
              "brief": {
                "type": "string",
                "minLength": 1,
                "maxLength": 8000
              },
              "targetSeconds": {
                "default": 30,
                "type": "integer",
                "minimum": 5,
                "maximum": 300
              },
              "captions": {
                "default": true,
                "type": "boolean"
              },
              "title": {
                "default": null,
                "anyOf": [
                  {
                    "type": "string",
                    "maxLength": 80
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "brandText": {
                "default": null,
                "anyOf": [
                  {
                    "type": "string",
                    "maxLength": 60
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "brief"
            ],
            "additionalProperties": false
          }
        },
        "integrations": [
          {
            "tool": "social.publish",
            "label": "Publishing the video to social media",
            "connected": false
          }
        ],
        "defaults": {
          "executionMode": "review",
          "maxJobsPerDay": null
        }
      },
      "available": true,
      "unavailableReason": null,
      "setup": {
        "ready": true,
        "missing": [],
        "unavailableActions": [
          "Publishing the video to social media: needs a Social media account connection, which isn't available."
        ]
      },
      "installed": null
    }
  ]
}
