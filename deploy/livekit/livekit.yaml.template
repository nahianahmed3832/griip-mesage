# Generated by scripts/gen-config.sh from .env — do not commit the rendered livekit.yaml (contains the API secret).
port: 7880
bind_addresses: ["0.0.0.0"]
rtc:
  tcp_port: __RTC_TCP_PORT__
  udp_port: __RTC_UDP_PORT__
  use_external_ip: __USE_EXTERNAL_IP__
  __NODE_IP_LINE__
keys:
  __LIVEKIT_API_KEY__: __LIVEKIT_API_SECRET__
webhook:
  api_key: __LIVEKIT_API_KEY__
  urls:
    - http://api:8080/v1/livekit/webhook
room:
  empty_timeout: 60
  departure_timeout: 20
  max_participants: 12
logging:
  level: info
